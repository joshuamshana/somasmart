# JWT signing secret for tenant and platform token classes
JWT_SECRET=replace-with-strong-random-secret

# Postgres connection
DATABASE_URL=postgresql://joshua:joshua@localhost/blackdb
# Optional: set to "memory" to force in-memory store
DATA_STORE=knex

# Required bootstrap seed values (no hardcoded demo users)
SEED_PROJECT_KEY=somasmart
SEED_PROJECT_NAME=SomaSmart
SEED_TENANT_ADMIN_USERNAME=admin
SEED_TENANT_ADMIN_PASSWORD=replace-with-strong-tenant-admin-password
SEED_PLATFORM_ADMIN_USERNAME=platform_admin
SEED_PLATFORM_ADMIN_PASSWORD=replace-with-strong-platform-admin-password

# Server bind
PORT=4000
HOST=0.0.0.0

# CORS allowlist as comma-separated origins (use * to allow all)
CORS_ORIGINS=http://localhost:3000,http://localhost:400,http://localhost:5173,http://localhost:4173

# Max allowed JSON payload size in bytes (request bodies above this are rejected with 413)
MAX_JSON_BODY_BYTES=1048576

# Enforce HTTPS requests at guard layer (defaults true in production)
REQUIRE_HTTPS=false
